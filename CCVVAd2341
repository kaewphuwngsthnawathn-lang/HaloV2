--// SETTINGS & STATE //--
_G.AutoFarmItem = false
_G.MaxHeightDiff = 6.5       -- ความสูงสูงสุดที่ยอมรับได้ (ถ้าไอเทมอยู่สูงกว่าตัวละครเกินค่านี้จะข้ามทันที)
_G.HoldDurationFallback = 1.5
_G.SelectedItems = {}

local IgnoredItems = {}      -- เก็บรายการไอเทมที่เดินไปไม่ถึงชั่วคราว (ป้องกันเดินชนกำแพงซ้ำ)

local function GetCharacterParts()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return char, root, hum
end

local function StopWalking()
    local _, root, hum = GetCharacterParts()
    if hum and root then
        hum:MoveTo(root.Position)
    end
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- หันกล้องมองไอเทม 1 ครั้งแบบไม่ล็อคค้าง
local function SnapCameraToTarget(targetPos)
    local cam = Workspace.CurrentCamera
    if cam and targetPos then
        local currentCamPos = cam.CFrame.Position
        if (currentCamPos - targetPos).Magnitude > 15 then
            currentCamPos = targetPos + Vector3.new(0, 3, 5)
        end
        cam.CFrame = CFrame.lookAt(currentCamPos, targetPos)
    end
end

local function IsItemGone(item)
    if not item or not item.Parent or not item:IsDescendantOf(Workspace) then
        return true
    end
    return false
end

local function GetItemFolder()
    local gameplay = Workspace:FindFirstChild("Gameplay")
    if gameplay and gameplay:FindFirstChild("Item") then
        return gameplay.Item
    end
    return Workspace:FindFirstChild("Item")
end

local function ScanItemNames()
    local names = {}
    local it = GetItemFolder()
    if it then
        for _, item in ipairs(it:GetChildren()) do
            if not table.find(names, item.Name) then
                table.insert(names, item.Name)
            end
        end
    end
    table.sort(names)
    return names
end

-- ตรวจสอบว่าไอเทมอยู่บนพื้นและไม่สูงเกินตัวละคร
local function IsItemOnGround(rootPos, itemPos)
    local heightDiff = itemPos.Y - rootPos.Y
    -- ถ้าอยู่สูงเกินกำหนด (เช่น บนหลังคา บนต้นไม้ หรือชั้นบน) ให้ปล่อยผ่านเลย
    if heightDiff > (_G.MaxHeightDiff or 6.5) then
        return false
    end
    -- ถ้าอยู่ต่ำกว่าตัวละครมากเกินไป (เช่น ใต้แมพ) ก็ข้ามเช่นกัน
    if heightDiff < -15 then
        return false
    end
    return true
end

-- ค้นหาไอเทมที่ใกล้ที่สุดและคำนวณเส้นทางได้จริง
local function GetBestReachableItem()
    local it = GetItemFolder()
    local _, root, _ = GetCharacterParts()
    if not it or not root then return nil end

    local hasFilters = false
    for _, state in pairs(_G.SelectedItems) do
        if state then hasFilters = true break end
    end

    local candidates = {}

    for _, item in ipairs(it:GetChildren()) do
        if item and item.Parent and not IgnoredItems[item] then
            local isAllowed = true
            if hasFilters and not _G.SelectedItems[item.Name] then
                isAllowed = false
            end

            if isAllowed then
                local anchor = item:FindFirstChild("PickupAnchor") or item:FindFirstChildWhichIsA("BasePart")
                local targetPos = anchor and anchor.Position or item:GetPivot().Position
                
                -- กรองเฉพาะไอเทมที่อยู่ระดับพื้น (ไม่สูงเกินตัวละคร)
                if targetPos and IsItemOnGround(root.Position, targetPos) then
                    local dist = (root.Position - targetPos).Magnitude
                    table.insert(candidates, {
                        Instance = item,
                        Anchor = anchor,
                        Position = targetPos,
                        Prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true),
                        Distance = dist
                    })
                end
            end
        end
    end

    -- เรียงลำดับจากใกล้ไปไกล
    table.sort(candidates, function(a, b)
        return a.Distance < b.Distance
    end)

    -- คำนวณเส้นทาง (Pathfinding) เพื่อเช็คว่ามีทางเดินไปได้จริงหรือไม่
    for _, candidate in ipairs(candidates) do
        local path = PathfindingService:CreatePath({
            AgentRadius = 2.0,
            AgentHeight = 5.0,
            AgentCanJump = true,
            WaypointSpacing = 4.0
        })

        local success = pcall(function()
            path:ComputeAsync(root.Position, candidate.Position)
        end)

        if success and path.Status == Enum.PathStatus.Success then
            candidate.Waypoints = path:GetWaypoints()
            return candidate
        else
            -- หากคำนวณเส้นทางไม่ได้ (ไม่มีทางไป) ให้ข้ามชิ้นนี้ชั่วคราว 15 วินาที
            IgnoredItems[candidate.Instance] = true
            task.delay(15, function()
                IgnoredItems[candidate.Instance] = nil
            end)
        end
    end

    return nil
end

-- เดินตามเส้นทางที่คำนวณไว้จนถึงไอเทม
local function WalkToTarget(target)
    local waypoints = target.Waypoints
    if not waypoints or #waypoints == 0 then return false end

    for i = 2, #waypoints do
        if not _G.AutoFarmItem or IsItemGone(target.Instance) then
            return false
        end

        local _, root, hum = GetCharacterParts()
        if not root or not hum then return false end

        local wp = waypoints[i]
        if wp.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end

        hum:MoveTo(wp.Position)

        -- รอจนกว่าจะเดินถึงจุด Waypoint ย่อย หรือเข้าใกล้ไอเทมในระยะเก็บได้แล้ว
        local wpStart = tick()
        while _G.AutoFarmItem and not IsItemGone(target.Instance) do
            _, root, hum = GetCharacterParts()
            if not root or not hum then return false end

            local currentItemPos = (target.Anchor and target.Anchor.Parent and target.Anchor.Position) or target.Position
            if (root.Position - currentItemPos).Magnitude <= 5.5 then
                return true -- ถึงระยะเก็บไอเทมแล้ว
            end

            local distToWp = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(wp.Position.X, 0, wp.Position.Z)).Magnitude
            if distToWp <= 3.0 then
                break -- ถึงจุด Waypoint นี้แล้ว ไปจุดต่อไป
            end

            -- ป้องกันเดินติดสิ่งกีดขวางนานเกินไป (เกิน 2.5 วิต่อ 1 ก้าว ให้กระโดดหรือยกเลิก)
            if tick() - wpStart > 2.5 then
                hum.Jump = true
                if tick() - wpStart > 4.0 then
                    IgnoredItems[target.Instance] = true
                    task.delay(15, function() IgnoredItems[target.Instance] = nil end)
                    return false
                end
            end

            task.wait(0.05)
        end
    end

    local _, root = GetCharacterParts()
    local finalItemPos = (target.Anchor and target.Anchor.Parent and target.Anchor.Position) or target.Position
    if root and (root.Position - finalItemPos).Magnitude <= 7.0 then
        return true
    end

    return false
end

-- หยุดเดิน หันมอง และกด E เก็บไอเทมจนสุด
local function CollectItemByWalking(target)
    local item = target.Instance
    local _, root, hum = GetCharacterParts()
    if not root or not hum or not item or not item.Parent then return end

    -- หยุดเดินให้นิ่ง
    hum:MoveTo(root.Position)

    local targetPos = (target.Anchor and target.Anchor.Parent and target.Anchor.Position) or item:GetPivot().Position
    
    -- หันตัวละครและกล้องไปทางไอเทม
    root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
    SnapCameraToTarget(targetPos)
    task.wait(0.15)

    local prompt = target.Prompt or item:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        prompt.Enabled = true
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 999
    end

    local holdTime = _G.HoldDurationFallback or 1.5
    if prompt and prompt.HoldDuration > 0 then
        holdTime = prompt.HoldDuration + 0.45
    end

    -- กด E ค้างไว้จนสุดหลอด
    VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    if prompt and prompt.InputHoldBegin then
        pcall(function() prompt:InputHoldBegin() end)
    end

    local attemptStart = tick()
    while _G.AutoFarmItem and not IsItemGone(item) and (tick() - attemptStart < holdTime + 1.5) do
        if fireproximityprompt and prompt then
            pcall(function() fireproximityprompt(prompt) end)
        end
        task.wait(0.1)
    end

    -- ปล่อยปุ่ม E
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    if prompt and prompt.InputHoldEnd then
        pcall(function() prompt:InputHoldEnd() end)
    end
end

