--// AUTO FARM WORKER LOOP //--
task.spawn(function()
    while true do
        if _G.AutoFarmItem then
            local target = GetBestReachableTarget()
            
            if target and target.Instance and not IsTargetGone(target.Instance) then
                local reached = WalkToTarget(target)
                
                if reached and _G.AutoFarmItem and not IsTargetGone(target.Instance) then
                    CollectTarget(target)
                end
                task.wait(0.1)
            else
                task.wait(0.5)
            end
        else
            task.wait(0.3)
        end
    end
end)

