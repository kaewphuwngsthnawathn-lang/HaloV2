local function GetCharacterParts()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return char, root, hum
end

local function StopWalking()
    local _, root, hum = GetCharacterParts()
    if hum and root then
        hum:MoveTo(root.Position)
    end
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function SnapCameraToTarget(targetPos)
    local cam = Workspace.CurrentCamera
    if cam and targetPos then
        local currentCamPos = cam.CFrame.Position
        if (currentCamPos - targetPos).Magnitude > 15 then
            currentCamPos = targetPos + Vector3.new(0, 3, 5)
        end
        cam.CFrame = CFrame.lookAt(currentCamPos, targetPos)
    end
end

local function IsTargetGone(targetObj)
    if not targetObj or not targetObj.Parent or not targetObj:IsDescendantOf(Workspace) then
        return true
    end
    return false
end

-- ตรวจสอบว่าเป็นประตูอีเวนต์ฮาโลวีนหรือไม่
local function IsHalloweenDoor(obj, prompt)
    local combinedText = (obj.Name .. " " .. (prompt and (prompt.ObjectText .. " " .. prompt.ActionText) or "")):lower()
    if combinedText:find("door") or combinedText:find("halloween") or combinedText:find("candy") or combinedText:find("trick") or combinedText:find("knock") then
        return true
    end
    return false
end

-- สแกนหาไอเทมและประตูฮาโลวีนครอบคลุมทั้งแมพ (ไม่จำกัดระยะ)
local function GetAllMapTargets()
    local targets = {}
    local seen = {}

    local function registerTarget(obj, isDoorOverride)
        if not obj or not obj.Parent or seen[obj] then return end
        seen[obj] = true

        local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        local anchor = obj:FindFirstChild("PickupAnchor") 
            or (prompt and prompt.Parent and prompt.Parent:IsA("BasePart") and prompt.Parent)
            or (obj:IsA("BasePart") and obj)
            or obj:FindFirstChildWhichIsA("BasePart", true)

        if anchor then
            local isDoor = isDoorOverride or IsHalloweenDoor(obj, prompt)
            local displayName = obj.Name
            if isDoor then
                displayName = "[🎃 Event Door] " .. obj.Name
            end

            table.insert(targets, {
                Instance = obj,
                Name = obj.Name,
                DisplayName = displayName,
                Anchor = anchor,
                Prompt = prompt,
                IsDoor = isDoor
            })
        end
    end

    -- 1. ค้นหาในโฟลเดอร์ไอเทมหลักของแมพ (ทั้งแมพ)
    local itemFolders = {}
    local gameplay = Workspace:FindFirstChild("Gameplay")
    if gameplay and gameplay:FindFirstChild("Item") then
        table.insert(itemFolders, gameplay.Item)
    end
    if Workspace:FindFirstChild("Item") then
        table.insert(itemFolders, Workspace.Item)
    end
    if Workspace:FindFirstChild("Items") then
        table.insert(itemFolders, Workspace.Items)
    end

    for _, folder in ipairs(itemFolders) do
        for _, item in ipairs(folder:GetChildren()) do
            registerTarget(item, false)
        end
    end

    -- 2. ค้นหาประตูอีเวนต์ฮาโลวีนหรือไอเทมที่มี ProximityPrompt ทั่วทั้ง Workspace (ระยะไกลทั้งแมพ)
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Parent then
            -- ข้ามตัวละครผู้เล่น
            local modelAncestor = desc:FindFirstAncestorOfClass("Model")
            if modelAncestor and Players:GetPlayerFromCharacter(modelAncestor) then
                continue
            end

            local targetContainer = modelAncestor or desc.Parent
            if not seen[targetContainer] then
                if IsHalloweenDoor(targetContainer, desc) then
                    registerTarget(targetContainer, true)
                end
            end
        end
    end

    return targets
end

local function ScanItemNames()
    local names = {}
    local allTargets = GetAllMapTargets()
    for _, t in ipairs(allTargets) do
        if not table.find(names, t.Name) then
            table.insert(names, t.Name)
        end
    end
    table.sort(names)
    return names
end

--// ระบบ ESP แสดงชื่อไอเทมระยะไกลทั้งแมพ //--
local function ClearAllESP()
    for obj, gui in pairs(ActiveESPs) do
        if gui and gui.Parent then
            gui:Destroy()
        end
    end
    table.clear(ActiveESPs)
end

local function UpdateItemESP()
    if not _G.ShowItemESP then
        ClearAllESP()
        return
    end

    local _, root, _ = GetCharacterParts()
    local allTargets = GetAllMapTargets()
    local validInstances = {}

    for _, t in ipairs(allTargets) do
        if t.Instance and t.Instance.Parent and t.Anchor and t.Anchor.Parent then
            validInstances[t.Instance] = true
            local dist = root and math.floor((root.Position - t.Anchor.Position).Magnitude) or 0

            local billboard = ActiveESPs[t.Instance]
            if not billboard or not billboard.Parent then
                billboard = Instance.new("BillboardGui")
                billboard.Name = "GeminiItemESP"
                billboard.AlwaysOnTop = true
                billboard.Size = UDim2.new(0, 200, 0, 40)
                billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                billboard.MaxDistance = math.huge -- มองเห็นได้ไกลทั้งแมพ
                billboard.Adornee = t.Anchor
                billboard.Parent = t.Anchor

                local label = Instance.new("TextLabel")
                label.Name = "Title"
                label.Parent = billboard
                label.BackgroundTransparency = 1
                label.Size = UDim2.new(1, 0, 1, 0)
                label.Font = Enum.Font.GothamBold
                label.TextSize = 13
                label.TextStrokeTransparency = 0.2
                label.TextStrokeColor3 = Color3.new(0, 0, 0)
                label.TextColor3 = t.IsDoor and Color3.fromRGB(255, 165, 0) or Color3.fromRGB(100, 255, 150)

                ActiveESPs[t.Instance] = billboard
            end

            local label = billboard:FindFirstChild("Title")
            if label then
                local statusTag = IgnoredTargets[t.Instance] and " [Cooldown]" or ""
                label.Text = string.format("%s\n[%dm]%s", t.DisplayName, dist, statusTag)
            end
        end
    end

    -- ลบ ESP ของไอเทมที่ถูกเก็บไปแล้ว
    for obj, gui in pairs(ActiveESPs) do
        if not validInstances[obj] or not obj.Parent then
            if gui and gui.Parent then gui:Destroy() end
            ActiveESPs[obj] = nil
        end
    end
end

