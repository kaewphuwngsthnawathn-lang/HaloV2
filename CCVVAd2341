-- ตรวจสอบว่าไอเทมอยู่บนพื้นและไม่สูงเกินตัวละคร
local function IsTargetOnGround(rootPos, targetPos)
    local heightDiff = targetPos.Y - rootPos.Y
    if heightDiff > (_G.MaxHeightDiff or 7.5) then
        return false
    end
    if heightDiff < -15 then
        return false
    end
    return true
end

-- ค้นหาเป้าหมายที่ดีที่สุดจากทั้งแมพและคำนวณเส้นทางเดิน
local function GetBestReachableTarget()
    local _, root, _ = GetCharacterParts()
    if not root then return nil end

    local hasFilters = false
    for _, state in pairs(_G.SelectedItems) do
        if state then hasFilters = true break end
    end

    local allTargets = GetAllMapTargets()
    local candidates = {}

    for _, t in ipairs(allTargets) do
        if t.Instance and t.Instance.Parent and not IgnoredTargets[t.Instance] then
            local isAllowed = true

            if t.IsDoor then
                if not _G.FarmHalloweenDoors then
                    isAllowed = false
                end
                -- ถ้าประตูถูกปิดใช้งาน Prompt ชั่วคราว (กดรับ Candy ไปแล้ว) ให้ข้าม
                if t.Prompt and not t.Prompt.Enabled then
                    isAllowed = false
                end
            else
                if hasFilters and not _G.SelectedItems[t.Name] then
                    isAllowed = false
                end
            end

            if isAllowed and t.Anchor and t.Anchor.Parent then
                local targetPos = t.Anchor.Position
                if IsTargetOnGround(root.Position, targetPos) then
                    t.Position = targetPos
                    t.Distance = (root.Position - targetPos).Magnitude
                    table.insert(candidates, t)
                end
            end
        end
    end

    -- เรียงลำดับจากใกล้ไปไกล (ครอบคลุมระยะไกลทั้งแมพ)
    table.sort(candidates, function(a, b)
        return a.Distance < b.Distance
    end)

    -- คำนวณเส้นทาง (Pathfinding) เพื่อหาเส้นทางเดินที่ไปได้จริง
    for _, candidate in ipairs(candidates) do
        local path = PathfindingService:CreatePath({
            AgentRadius = 2.0,
            AgentHeight = 5.0,
            AgentCanJump = true,
            WaypointSpacing = 4.0
        })

        local success = pcall(function()
            path:ComputeAsync(root.Position, candidate.Position)
        end)

        if success and path.Status == Enum.PathStatus.Success then
            candidate.Waypoints = path:GetWaypoints()
            return candidate
        else
            -- หากยังหาทางเดินตรงๆ ไม่เจอ ให้ข้ามชั่วคราว 12 วินาทีแล้วลองสแกนใหม่
            IgnoredTargets[candidate.Instance] = true
            task.delay(12, function()
                IgnoredTargets[candidate.Instance] = nil
            end)
        end
    end

    return nil
end

-- เดินตามเส้นทางที่คำนวณไว้จนถึงเป้าหมาย
local function WalkToTarget(target)
    local waypoints = target.Waypoints
    if not waypoints or #waypoints == 0 then return false end

    for i = 2, #waypoints do
        if not _G.AutoFarmItem or IsTargetGone(target.Instance) then
            return false
        end

        local _, root, hum = GetCharacterParts()
        if not root or not hum then return false end

        local wp = waypoints[i]
        if wp.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end

        hum:MoveTo(wp.Position)

        local wpStart = tick()
        while _G.AutoFarmItem and not IsTargetGone(target.Instance) do
            _, root, hum = GetCharacterParts()
            if not root or not hum then return false end

            local currentPos = (target.Anchor and target.Anchor.Parent and target.Anchor.Position) or target.Position
            if (root.Position - currentPos).Magnitude <= 6.0 then
                return true -- ถึงระยะกดเก็บแล้ว
            end

            local distToWp = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(wp.Position.X, 0, wp.Position.Z)).Magnitude
            if distToWp <= 3.0 then
                break
            end

            if tick() - wpStart > 2.5 then
                hum.Jump = true
                if tick() - wpStart > 4.5 then
                    IgnoredTargets[target.Instance] = true
                    task.delay(12, function() IgnoredTargets[target.Instance] = nil end)
                    return false
                end
            end

            task.wait(0.05)
        end
    end

    local _, root = GetCharacterParts()
    local finalPos = (target.Anchor and target.Anchor.Parent and target.Anchor.Position) or target.Position
    if root and (root.Position - finalPos).Magnitude <= 7.5 then
        return true
    end

    return false
end

-- หยุดเดิน หันมอง และกด E ค้างเพื่อเก็บไอเทมหรือเปิดประตูรับ Candy
local function CollectTarget(target)
    local obj = target.Instance
    local _, root, hum = GetCharacterParts()
    if not root or not hum or not obj or not obj.Parent then return end

    hum:MoveTo(root.Position)

    local targetPos = (target.Anchor and target.Anchor.Parent and target.Anchor.Position) or obj:GetPivot().Position
    root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
    SnapCameraToTarget(targetPos)
    task.wait(0.15)

    local prompt = target.Prompt or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        -- สำหรับประตูอีเวนต์ จะไม่บังคับเปิด Enabled ถ้าประตูติดคูลดาวน์จากเซิร์ฟเวอร์อยู่
        if not target.IsDoor then
            prompt.Enabled = true
        end
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 999
    end

    local holdTime = _G.HoldDurationFallback or 2.0
    if prompt and prompt.HoldDuration > 0 then
        holdTime = prompt.HoldDuration + 0.5
    end

    -- เริ่มกดปุ่ม E ค้างไว้จนสุดหลอด
    VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    if prompt and prompt.InputHoldBegin then
        pcall(function() prompt:InputHoldBegin() end)
    end

    local attemptStart = tick()
    while _G.AutoFarmItem and not IsTargetGone(obj) and (tick() - attemptStart < holdTime + 1.0) do
        -- หากเป็นประตูอีเวนต์และ Prompt ถูกปิด (แปลว่ากดรับ Candy สำเร็จแล้ว) ให้หยุดกดทันที
        if target.IsDoor and prompt and not prompt.Enabled then
            break
        end

        if fireproximityprompt and prompt and prompt.Enabled then
            pcall(function() fireproximityprompt(prompt) end)
        end
        task.wait(0.1)
    end

    -- ปล่อยปุ่ม E
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    if prompt and prompt.InputHoldEnd then
        pcall(function() prompt:InputHoldEnd() end)
    end

    -- หากเป็นประตูอีเวนต์ฮาโลวีน ให้ติดคูลดาวน์ประตูบานนี้ไว้ 45 วินาที เพื่อเดินไปหาไอเทมหรือประตูบานอื่นต่อ
    if target.IsDoor then
        IgnoredTargets[obj] = true
        task.delay(45, function()
            IgnoredTargets[obj] = nil
        end)
    end
end

