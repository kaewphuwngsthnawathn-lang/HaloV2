--// AUTO FARM WORKER LOOP //--
task.spawn(function()
    while true do
        if _G.AutoFarmItem then
            local target = GetBestReachableItem()
            
            if target and target.Instance and not IsItemGone(target.Instance) then
                local reached = WalkToTarget(target)
                
                if reached and _G.AutoFarmItem and not IsItemGone(target.Instance) then
                    CollectItemByWalking(target)
                end
                task.wait(0.1)
            else
                task.wait(0.5)
            end
        else
            task.wait(0.3)
        end
    end
end)

