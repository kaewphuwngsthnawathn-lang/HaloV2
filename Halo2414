local function GetMyRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function ReleaseCharacter()
    local root = GetMyRoot()
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- หันกล้องมองไอเทม 1 ครั้งแบบไม่ล็อคค้าง
local function SnapCameraToTarget(targetPos)
    local cam = Workspace.CurrentCamera
    if cam and targetPos then
        local currentCamPos = cam.CFrame.Position
        if (currentCamPos - targetPos).Magnitude > 15 then
            currentCamPos = targetPos + Vector3.new(0, 3, 5)
        end
        cam.CFrame = CFrame.lookAt(currentCamPos, targetPos)
    end
end

local function IsItemGone(item)
    if not item or not item.Parent or not item:IsDescendantOf(Workspace) then
        return true
    end
    return false
end

local function GetItemFolder()
    local gameplay = Workspace:FindFirstChild("Gameplay")
    if gameplay and gameplay:FindFirstChild("Item") then
        return gameplay.Item
    end
    return Workspace:FindFirstChild("Item")
end

local function ScanItemNames()
    local names = {}
    local it = GetItemFolder()
    if it then
        for _, item in ipairs(it:GetChildren()) do
            if not table.find(names, item.Name) then
                table.insert(names, item.Name)
            end
        end
    end
    table.sort(names)
    return names
end

local function GetNearestItem()
    local it = GetItemFolder()
    local root = GetMyRoot()
    if not it or not root then return nil end

    local hasFilters = false
    for _, state in pairs(_G.SelectedItems) do
        if state then hasFilters = true break end
    end

    local nearest = nil
    local minDist = math.huge

    for _, item in ipairs(it:GetChildren()) do
        if item and item.Parent then
            local isAllowed = true
            if hasFilters and not _G.SelectedItems[item.Name] then
                isAllowed = false
            end

            if isAllowed then
                local anchor = item:FindFirstChild("PickupAnchor") or item:FindFirstChildWhichIsA("BasePart")
                local targetPos = anchor and anchor.Position or item:GetPivot().Position
                
                if targetPos then
                    local dist = (root.Position - targetPos).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = {
                            Instance = item,
                            Anchor = anchor,
                            Pivot = item:GetPivot(),
                            Prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true),
                            Distance = dist
                        }
                    end
                end
            end
        end
    end

    return nearest
end

-- ฟังก์ชันวาปด้านบน + รอเท้าแตะพื้น + กด E อัตโนมัติจนสุด
local function CollectItemNatural(target)
    local item = target.Instance
    local root = GetMyRoot()
    if not root or not item or not item.Parent then return end
    
    local initialCF = (target.Anchor and target.Anchor.Parent and target.Anchor.CFrame) or item:GetPivot()
    
    -- 1. วาปไปอยู่เหนือไอเทมเล็กน้อย (3.5 studs) และปลด Anchored เพื่อให้ตัวละครตกลงมาแตะพื้นอย่างเป็นธรรมชาติ
    root.Anchored = false
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = initialCF + Vector3.new(0, 3.5, 0)
    
    -- 2. หันกล้องมองไอเทม 1 ครั้ง
    SnapCameraToTarget(initialCF.Position)
    
    -- 3. ดีเลย์นิดหน่อยเพื่อให้มั่นใจว่าเท้าตัวละครแตะถึงพื้นเรียบร้อย
    task.wait(0.35)

    -- ค้นหา ProximityPrompt
    local prompt = target.Prompt or item:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        prompt.Enabled = true
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 999
    end

    local holdTime = _G.HoldDurationFallback or 1.5
    if prompt and prompt.HoldDuration > 0 then
        holdTime = prompt.HoldDuration + 0.45
    end

    -- 4. สั่งกดปุ่ม E ค้างไว้อัตโนมัติจนสุด
    VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    if prompt and prompt.InputHoldBegin then
        pcall(function() prompt:InputHoldBegin() end)
    end

    local attemptStart = tick()
    while _G.AutoFarmItem and not IsItemGone(item) and (tick() - attemptStart < holdTime + 2.0) do
        root = GetMyRoot()
        if fireproximityprompt and prompt then
            pcall(function() fireproximityprompt(prompt) end)
        end
        task.wait(0.1)
    end

    -- ปล่อยปุ่ม E
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    if prompt and prompt.InputHoldEnd then
        pcall(function() prompt:InputHoldEnd() end)
    end
end

