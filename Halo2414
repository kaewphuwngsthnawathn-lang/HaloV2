--// AUTO FARM WORKER LOOP //--
task.spawn(function()
    while true do
        if _G.AutoFarmItem then
            local target = GetNearestItem()
            
            if target and target.Instance and not IsItemGone(target.Instance) then
                while _G.AutoFarmItem and not IsItemGone(target.Instance) do
                    CollectItemNatural(target)
                    
                    if not IsItemGone(target.Instance) then
                        task.wait(0.2)
                    end
                end
                task.wait(0.1)
            else
                ReleaseCharacter()
                task.wait(0.4)
            end
        else
            task.wait(0.3)
        end
    end
end)

