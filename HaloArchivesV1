    Toggle:OnChanged(function(Value)
        Collector.Enabled = Value

        if not Value then
            Walker:Cancel()
        end
    end)

    task.spawn(function()
        while task.wait(0.1) do
            if Collector.Enabled then
                Collector:CollectAll()
            end

            if Fluent.Unloaded then
                break
            end
        end
    end)

    task.spawn(function()
        while task.wait(1) do
            pcall(function()
                local Channel = Items:GetChannel()
                local Remote = "no remote"

                if Channel then
                    Remote = "remote ok"
                end

                local State = "Idle"

                if Collector.Dying then
                    State = "Respawning"
                elseif Collector.Enabled then
                    State = "Collecting"
                end

                Info:SetDesc(string.format(
                    "Picked %d | Ground %d | Stuck %d/%d | %s | %s | %s",
                    Collector.Picked,
                    Items:Count(),
                    Collector.Stuck,
                    Collector.StuckLimit,
                    State,
                    Collector.LastReason,
                    Remote
                ))
            end)

            if Fluent.Unloaded then
                break
            end
        end
    end)
end

UserInputService.WindowFocusReleased:Connect(function()
    Walker:Cancel()
end)

Window:SelectTab(1)

Fluent:Notify({
    Title = "Halo Archives",
    Content = "Auto collect is ready.",
    Duration = 6
})

