--// SETTINGS & STATE //--
_G.AutoFarmItem = false
_G.HoldDurationFallback = 1.5
_G.SelectedItems = {}

local function GetMyRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- ปลดล็อกตัวละครเมื่อหยุดฟาร์ม
local function ReleaseCharacter()
    local root = GetMyRoot()
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- หันมุมกล้องไปมองที่ไอเทม 1 ครั้ง (ไม่ล็อคค้าง ผู้เล่นยังหมุนกล้องเองได้)
local function SnapCameraToTarget(targetPos)
    local cam = Workspace.CurrentCamera
    if cam and targetPos then
        local currentCamPos = cam.CFrame.Position
        -- หันหน้ากล้องไปยังตำแหน่งไอเทมจากตำแหน่งกล้องปัจจุบัน (หรือขยับเข้าใกล้เล็กน้อยถ้าอยู่ไกล)
        if (currentCamPos - targetPos).Magnitude > 15 then
            currentCamPos = targetPos + Vector3.new(0, 3, 5)
        end
        cam.CFrame = CFrame.lookAt(currentCamPos, targetPos)
    end
end

-- ตรวจสอบว่าไอเทมหายไปจากแมพหรือยัง
local function IsItemGone(item)
    if not item or not item.Parent or not item:IsDescendantOf(Workspace) then
        return true
    end
    return false
end

-- ค้นหาโฟลเดอร์ไอเทมใน Workspace (รองรับทั้ง Gameplay.Item และ Item)
local function GetItemFolder()
    local gameplay = Workspace:FindFirstChild("Gameplay")
    if gameplay and gameplay:FindFirstChild("Item") then
        return gameplay.Item
    end
    return Workspace:FindFirstChild("Item")
end

-- สแกนรายชื่อไอเทมทั้งหมดในแมพ
local function ScanItemNames()
    local names = {}
    local it = GetItemFolder()
    if it then
        for _, item in ipairs(it:GetChildren()) do
            if not table.find(names, item.Name) then
                table.insert(names, item.Name)
            end
        end
    end
    table.sort(names)
    return names
end

-- ค้นหาไอเทมที่ใกล้ผู้เล่นที่สุด
local function GetNearestItem()
    local it = GetItemFolder()
    local root = GetMyRoot()
    if not it or not root then return nil end

    local hasFilters = false
    for _, state in pairs(_G.SelectedItems) do
        if state then hasFilters = true break end
    end

    local nearest = nil
    local minDist = math.huge

    for _, item in ipairs(it:GetChildren()) do
        if item and item.Parent then
            local isAllowed = true
            if hasFilters and not _G.SelectedItems[item.Name] then
                isAllowed = false
            end

            if isAllowed then
                local anchor = item:FindFirstChild("PickupAnchor") or item:FindFirstChildWhichIsA("BasePart")
                local targetPos = anchor and anchor.Position or item:GetPivot().Position
                
                if targetPos then
                    local dist = (root.Position - targetPos).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = {
                            Instance = item,
                            Anchor = anchor,
                            Pivot = item:GetPivot(),
                            Prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true),
                            Distance = dist
                        }
                    end
                end
            end
        end
    end

    return nearest
end

-- ฟังก์ชันวาปและเก็บไอเทมแบบผสมผสาน (แก้ปัญหากด E ไม่ติด)
local function CollectItemHybrid(target)
    local item = target.Instance
    local root = GetMyRoot()
    if not root or not item or not item.Parent then return end
    
    local initialCF = (target.Anchor and target.Anchor.Parent and target.Anchor.CFrame) or item:GetPivot()
    
    -- 1. วาปไปหาไอเทม (วางตัวละครให้อยู่ระดับเดียวกับไอเทม ไม่สูงเกินไปจนหลุดระยะ ProximityPrompt)
    root.Anchored = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(initialCF.Position + Vector3.new(0, 0.5, 0))
    
    -- 2. ปรับมุมกล้องหันมองไอเทม 1 ครั้ง (ไม่ล็อคค้าง)
    SnapCameraToTarget(initialCF.Position)
    
    -- รอให้ตัวเกมอัปเดต Prompt บนหน้าจอ
    task.wait(0.15)

    -- ค้นหา ProximityPrompt ทั้งหมดในตัวไอเทม (เผื่อบางชิ้นมีหลาย Prompt)
    local prompts = {}
    for _, desc in ipairs(item:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            desc.Enabled = true
            desc.RequiresLineOfSight = false
            desc.MaxActivationDistance = 999
            table.insert(prompts, desc)
        end
    end

    local holdTime = _G.HoldDurationFallback or 1.5
    if #prompts > 0 and prompts[1].HoldDuration > 0 then
        holdTime = prompts[1].HoldDuration + 0.35
    end

    -- 3. สั่งเก็บแบบผสมผสาน (ทั้งสั่ง Prompt โดยตรง + กดปุ่ม E ค้างไว้)
    -- วิธีที่ A: สั่งเริ่มกดค้างผ่าน Prompt API ของ Roblox โดยตรง (ถ้า Executor รองรับ)
    for _, p in ipairs(prompts) do
        pcall(function()
            if p.InputHoldBegin then
                p:InputHoldBegin()
            end
        end)
    end

    -- วิธีที่ B: จำลองการกดปุ่ม E ค้างไว้ผ่าน VIM
    VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    
    local attemptStart = tick()
    while _G.AutoFarmItem and not IsItemGone(item) and (tick() - attemptStart < holdTime) do
        root = GetMyRoot()
        if root and item and item.Parent then
            local currentCF = (target.Anchor and target.Anchor.Parent and target.Anchor.CFrame) or item:GetPivot()
            root.Anchored = true
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            -- เกาะติดไอเทมในระยะประชิด (0.5 studs)
            root.CFrame = CFrame.new(currentCF.Position + Vector3.new(0, 0.5, 0))
        end
        task.wait(0.05)
    end

    -- วิธีที่ C: ยิงคำสั่ง fireproximityprompt ปิดท้ายตอนครบเวลา (ช่วยให้เก็บติด 100% แม้เกมบล็อก VIM)
    if not IsItemGone(item) and fireproximityprompt then
        for _, p in ipairs(prompts) do
            pcall(function()
                fireproximityprompt(p)
            end)
        end
    end

    -- ปล่อยปุ่ม E และจบการกด Prompt
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    for _, p in ipairs(prompts) do
        pcall(function()
            if p.InputHoldEnd then
                p:InputHoldEnd()
            end
        end)
    end
    
    -- ปลดล็อกตัวละคร (ยืนอยู่ที่จุดล่าสุด ไม่ดีดกลับจุดเริ่มต้น)
    if root then
        root.Anchored = false
    end
end

