--// AUTO FARM WORKER LOOP //--
task.spawn(function()
    while true do
        if _G.AutoFarmItem then
            local target = GetNearestItem()
            
            if target and target.Instance and target.Instance.Parent then
                local targetCF = target.Anchor and target.Anchor.CFrame or target.Pivot
                local targetPos = targetCF.Position

                -- 1. วาปไปเหนือไอเทมเล็กน้อย (ป้องกันตัวละครจมดิน)
                TeleportToTarget(targetCF * CFrame.new(0, 1.5, 0))
                
                -- 2. ล็อคมุมกล้องไปที่ไอเทมทันทีหลังวาปถึง
                LockCameraToTarget(targetPos)
                task.wait(0.08) -- รอให้กล้องและตำแหน่งซิงค์กับเซิร์ฟเวอร์เสี้ยววินาที

                -- 3. กด E ค้างจนสุดหรือจนกว่าไอเทมจะเข้าตัวชัวร์
                HoldEAndCollect(target.Instance, target.Anchor, target.Prompt)
                
                task.wait(0.05)
            else
                task.wait(0.4)
            end
        else
            task.wait(0.3)
        end
    end
end)

