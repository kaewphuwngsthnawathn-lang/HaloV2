_G.AutoFarmItem = false
_G.HoldDurationFallback = 2.0
_G.SelectedItems = {}

local function GetMyRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- ปลดล็อกตัวละครเมื่อหยุดฟาร์ม
local function ReleaseCharacter()
    local root = GetMyRoot()
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- ล็อคมุมกล้องผู้เล่นให้หันไปมองที่จุดตำแหน่งของไอเทม
local function LockCameraToTarget(targetPos)
    local cam = Workspace.CurrentCamera
    if cam and targetPos then
        local camOffset = targetPos + Vector3.new(0, 2.5, 3.5)
        cam.CFrame = CFrame.lookAt(camOffset, targetPos)
    end
end

-- ตรวจสอบว่าไอเทมหายไปจากแมพหรือยัง
local function IsItemGone(item)
    if not item or not item.Parent or not item:IsDescendantOf(Workspace) then
        return true
    end
    return false
end

-- ค้นหาโฟลเดอร์ไอเทมใน Workspace (รองรับทั้ง Gameplay.Item และ Item)
local function GetItemFolder()
    local gameplay = Workspace:FindFirstChild("Gameplay")
    if gameplay and gameplay:FindFirstChild("Item") then
        return gameplay.Item
    end
    return Workspace:FindFirstChild("Item")
end

-- สแกนรายชื่อไอเทมทั้งหมดในแมพ
local function ScanItemNames()
    local names = {}
    local it = GetItemFolder()
    if it then
        for _, item in ipairs(it:GetChildren()) do
            if not table.find(names, item.Name) then
                table.insert(names, item.Name)
            end
        end
    end
    table.sort(names)
    return names
end

-- ค้นหาไอเทมที่ใกล้ผู้เล่นที่สุด
local function GetNearestItem()
    local it = GetItemFolder()
    local root = GetMyRoot()
    if not it or not root then return nil end

    local hasFilters = false
    for _, state in pairs(_G.SelectedItems) do
        if state then hasFilters = true break end
    end

    local nearest = nil
    local minDist = math.huge

    for _, item in ipairs(it:GetChildren()) do
        if item and item.Parent then
            local isAllowed = true
            if hasFilters and not _G.SelectedItems[item.Name] then
                isAllowed = false
            end

            if isAllowed then
                local anchor = item:FindFirstChild("PickupAnchor") or item:FindFirstChildWhichIsA("BasePart")
                local targetPos = anchor and anchor.Position or item:GetPivot().Position
                
                if targetPos then
                    local dist = (root.Position - targetPos).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = {
                            Instance = item,
                            Anchor = anchor,
                            Pivot = item:GetPivot(),
                            Prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true),
                            Distance = dist
                        }
                    end
                end
            end
        end
    end

    return nearest
end

-- ฟังก์ชันวาปเกาะติดและกด E ค้างจนกว่าไอเทมจะเข้าตัว
local function CollectItemPersistently(target)
    local item = target.Instance
    local prompt = target.Prompt
    
    -- 1. วาปไปหาไอเทมทันที
    local root = GetMyRoot()
    if not root then return end
    
    local initialCF = target.Anchor and target.Anchor.CFrame or target.Pivot
    root.Anchored = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = initialCF * CFrame.new(0, 1.5, 0)
    LockCameraToTarget(initialCF.Position)
    
    -- รอจังหวะให้เซิร์ฟเวอร์อัปเดตตำแหน่งผู้เล่นและขึ้นปุ่ม E บนหน้าจอ
    task.wait(0.15)

    -- ตั้งค่า ProximityPrompt ให้กดง่ายและไม่มีสิ่งกีดขวาง
    local holdTime = _G.HoldDurationFallback or 2.0
    if prompt and prompt.Parent then
        prompt.Enabled = true
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 999
        -- เผื่อเวลาเพิ่มอีก 0.4 วิ จาก HoldDuration จริงของเกม เพื่อให้หลอดวิ่งจนสุดชัวร์
        holdTime = (prompt.HoldDuration > 0 and (prompt.HoldDuration + 0.4)) or holdTime
    end

    -- 2. กดปุ่ม E ค้างไว้ (กดแช่ยาว ไม่ปล่อยจนกว่าจะครบหลอดหรือของหาย)
    VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    
    local attemptStart = tick()
    while _G.AutoFarmItem and not IsItemGone(item) and (tick() - attemptStart < holdTime) do
        root = GetMyRoot()
        if root and item and item.Parent then
            local currentCF = (target.Anchor and target.Anchor.Parent and target.Anchor.CFrame) or item:GetPivot()
            -- ยึดตำแหน่งตัวละครให้อยู่ที่ไอเทมตลอดเวลา ป้องกันเซิร์ฟเวอร์ดีดกลับที่เดิม
            root.Anchored = true
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = currentCF * CFrame.new(0, 1.5, 0)
            
            -- ล็อคมุมกล้องมองไอเทมตลอดเวลาที่กด E
            LockCameraToTarget(currentCF.Position)
        end
        task.wait(0.03)
    end

    -- 3. ปล่อยปุ่ม E เมื่อครบเวลาหรือเก็บสำเร็จ
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    
    -- ปลดล็อกตัวละครชั่วคราว (ไม่วาปกลับที่เดิม ตัวละครจะยืนรออยู่ที่จุดเก็บล่าสุดเพื่อไปชิ้นต่อไป)
    if root then
        root.Anchored = false
    end
end

