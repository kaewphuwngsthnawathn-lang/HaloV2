--// AUTO FARM WORKER LOOP (RETRY UNTIL COLLECTED) //--
task.spawn(function()
    while true do
        if _G.AutoFarmItem then
            local target = GetNearestItem()
            
            if target and target.Instance and not IsItemGone(target.Instance) then
                -- วนลูปเก็บไอเทมชิ้นนี้ซ้ำเรื่อยๆ จนกว่าจะหายเข้าตัว (หรือจนกว่าผู้เล่นจะกดปิด AutoFarm)
                while _G.AutoFarmItem and not IsItemGone(target.Instance) do
                    CollectItemPersistently(target)
                    
                    -- หากยังไม่เข้าตัว ให้พักเสี้ยววินาทีแล้วเริ่มวาปซ้ำ + กด E ใหม่ทันที
                    if not IsItemGone(target.Instance) then
                        task.wait(0.1)
                    end
                end
                
                -- เมื่อเก็บชิ้นนี้ได้แล้ว จะข้ามไปหาชิ้นถัดไปทันทีโดยไม่วาปกลับที่เดิม
                task.wait(0.05)
            else
                ReleaseCharacter()
                task.wait(0.4)
            end
        else
            task.wait(0.3)
        end
    end
end)

