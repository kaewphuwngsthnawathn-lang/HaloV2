--// SETTINGS & STATE //--
_G.AutoFarmItem = false
_G.TweenSpeed = 90
_G.PressEDelay = 0.1
_G.MaxWaitTime = 3.5
_G.SelectedItems = {}

local currentTween = nil

local function GetMyRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function StopMovement()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
end

-- Move to target using TweenService (Verified anti-rollback)
local function MoveToTarget(targetCF)
    local root = GetMyRoot()
    if not root then return false end

    StopMovement()
    local distance = (root.Position - targetCF.Position).Magnitude
    local duration = math.clamp(distance / (_G.TweenSpeed or 90), 0.1, 5)
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(root, tweenInfo, { CFrame = targetCF })
    currentTween:Play()
    currentTween.Completed:Wait()
    currentTween = nil
    return true
end

-- Trigger ProximityPrompt & Send E Key
local function TriggerCollection(prompt)
    if prompt and prompt.Parent then
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 999
        
        if fireproximityprompt then
            fireproximityprompt(prompt)
        end
    end

    VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.04)
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- Check if item is already collected/gone
local function IsItemGone(item)
    if not item or not item.Parent or not item:IsDescendantOf(Workspace) then
        return true
    end
    return false
end

-- Scan and return all unique item names in Gameplay.Item
local function ScanItemNames()
    local names = {}
    local it = Workspace:FindFirstChild("Gameplay") and Workspace.Gameplay:FindFirstChild("Item")
    if it then
        for _, item in ipairs(it:GetChildren()) do
            if not table.find(names, item.Name) then
                table.insert(names, item.Name)
            end
        end
    end
    table.sort(names)
    return names
end

-- Find the nearest eligible item to the player
local function GetNearestItem()
    local it = Workspace:FindFirstChild("Gameplay") and Workspace.Gameplay:FindFirstChild("Item")
    local root = GetMyRoot()
    if not it or not root then return nil end

    local hasFilters = false
    for _, state in pairs(_G.SelectedItems) do
        if state then hasFilters = true break end
    end

    local nearest = nil
    local minDist = math.huge

    for _, item in ipairs(it:GetChildren()) do
        if item and item.Parent then
            local isAllowed = true
            if hasFilters and not _G.SelectedItems[item.Name] then
                isAllowed = false
            end

            if isAllowed then
                local anchor = item:FindFirstChild("PickupAnchor") or item:FindFirstChildWhichIsA("BasePart")
                if anchor then
                    local dist = (root.Position - anchor.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = {
                            Instance = item,
                            Anchor = anchor,
                            Prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true),
                            Distance = dist
                        }
                    end
                end
            end
        end
    end

    return nearest
end

