--// AUTO FARM WORKER LOOP (VERIFIED) //--
task.spawn(function()
    while true do
        if _G.AutoFarmItem then
            local target = GetNearestItem()
            
            if target and target.Instance and target.Anchor and target.Anchor.Parent then
                -- 1. บินไปหาไอเทม (ลอยอยู่เหนือไอเทม 1.5 studs)
                local targetCF = target.Anchor.CFrame * CFrame.new(0, 1.5, 0)
                MoveToTarget(targetCF)
                
                -- 2. หยุดรอจนกว่าไอเทมจะหายไป พร้อมสแปมกด E และ FireProximityPrompt
                local startTime = tick()
                while _G.AutoFarmItem and not IsItemGone(target.Instance) and (tick() - startTime < (_G.MaxWaitTime or 3.5)) do
                    
                    local root = GetMyRoot()
                    if root then
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end

                    -- สั่งกด E + fireproximityprompt
                    local prompt = target.Prompt or target.Instance:FindFirstChildWhichIsA("ProximityPrompt", true)
                    TriggerCollection(prompt)
                    
                    task.wait(_G.PressEDelay or 0.1)
                end
                
                task.wait(0.05)
            else
                task.wait(0.5)
            end
        else
            task.wait(0.3)
        end
    end
end)

